# Digital Printing Queue Management System
# Environment Variables — EXAMPLE FILE
# Copy to .env (gitignored) and fill in real values

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=printqueue_db
DB_USERNAME=printqueue_user
DB_PASSWORD=your_strong_password_here

# ============================================================
# JWT CONFIGURATION
# ⚠️  IMPORTANT: Change JWT_SECRET to a random 256-bit string in production!
#    Generate with: openssl rand -base64 32
# ============================================================
JWT_SECRET=DigitalPrintQueueSecretKey2026AcademicDevOpsLab23IT723JNTU
JWT_EXPIRY_MS=86400000

# ============================================================
# APPLICATION CONFIGURATION
# ============================================================
APP_PORT=8080
FILE_UPLOAD_DIR=./uploads

# ============================================================
# PRINTER SIMULATION
# ============================================================
PRINTER_COUNT=3
PROCESSING_SECONDS_PER_PAGE=1
SCHEDULER_INTERVAL_MS=2000

# ============================================================
# DEMO ADMIN CREDENTIAL — ACADEMIC USE ONLY
# ⚠️  CHANGE IMMEDIATELY IN ANY PRODUCTION DEPLOYMENT
# Email   : admin@digitalprint.com
# Password: Admin@123
# ============================================================
